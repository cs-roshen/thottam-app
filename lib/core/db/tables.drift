-- The phone's database (task B2). Synced tables mirror supabase/migrations/0001_init.sql
-- column for column, without the server-only server_seq; test/core/db/schema_check_test.dart
-- fails when the two disagree.
--
-- Types: ids are UUID text (version 7 when made on the phone); money is integer paise;
-- quantities, areas, hours, attendance and shares are integer thousandths; dates of work are
-- 'YYYY-MM-DD' text so ranges use an index; timestamps are integer milliseconds since the
-- epoch, UTC; jsonb columns are JSON text.
--
-- There are no foreign keys here: pulled pages arrive table by table, so a child can land
-- before its parent. The server enforces references; the phone's repositories write parents
-- first. Checks that the server will never relax (worker or group, attendance range) are
-- repeated here, so the phone refuses a row instead of saving one that can never sync.
-- Lists of allowed values (modes, kinds) are not: the server may widen them later.

-- ---------- people and farms ----------
CREATE TABLE profiles (
  id TEXT NOT NULL PRIMARY KEY,
  full_name TEXT NOT NULL DEFAULT '',
  phone TEXT,
  language TEXT NOT NULL DEFAULT 'ml',
  large_text BOOLEAN NOT NULL DEFAULT FALSE,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL
) AS ProfileRow;

CREATE TABLE farms (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  district TEXT,
  settings TEXT NOT NULL DEFAULT '{}',
  accepted_template_version INTEGER NOT NULL DEFAULT 0,
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER
) AS FarmRow;

CREATE TABLE farm_members (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  user_id TEXT NOT NULL,
  role TEXT NOT NULL,
  permissions TEXT NOT NULL DEFAULT '{}',
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER
) AS FarmMemberRow;

CREATE INDEX farm_members_user ON farm_members (user_id, farm_id);

CREATE TABLE farm_invites (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  email TEXT NOT NULL,
  role TEXT NOT NULL,
  permissions TEXT NOT NULL DEFAULT '{}',
  accepted_at INTEGER,
  accepted_by TEXT,
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER
) AS FarmInviteRow;

CREATE INDEX farm_invites_farm ON farm_invites (farm_id);

-- ---------- templates ----------
CREATE TABLE crops (
  id TEXT NOT NULL PRIMARY KEY,
  code TEXT NOT NULL,
  name_ml TEXT NOT NULL,
  name_en TEXT NOT NULL,
  kind TEXT NOT NULL,
  default_unit TEXT NOT NULL DEFAULT 'kg',
  owner_farm_id TEXT,
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER
) AS CropRow;

CREATE INDEX crops_owner ON crops (owner_farm_id, code);

CREATE TABLE template_items (
  id TEXT NOT NULL PRIMARY KEY,
  crop_id TEXT,
  list_type TEXT NOT NULL,
  code TEXT NOT NULL,
  name_ml TEXT NOT NULL,
  name_en TEXT NOT NULL,
  data TEXT NOT NULL DEFAULT '{}',
  sort_order INTEGER NOT NULL DEFAULT 0,
  is_active BOOLEAN NOT NULL DEFAULT TRUE,
  template_version INTEGER NOT NULL DEFAULT 1,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL
) AS TemplateItemRow;

CREATE INDEX template_items_list ON template_items (list_type, crop_id, sort_order);

CREATE TABLE template_overrides (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  scope TEXT NOT NULL,
  scope_id TEXT,
  template_item_id TEXT,
  crop_id TEXT,
  list_type TEXT,
  code TEXT,
  name_ml TEXT,
  name_en TEXT,
  data TEXT NOT NULL DEFAULT '{}',
  hidden BOOLEAN,
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER
) AS TemplateOverrideRow;

CREATE INDEX template_overrides_farm ON template_overrides (farm_id) WHERE deleted_at IS NULL;

-- ---------- land and crops ----------
CREATE TABLE plots (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  name TEXT NOT NULL,
  area INTEGER,
  area_unit TEXT NOT NULL DEFAULT 'cent',
  tenure TEXT NOT NULL DEFAULT 'owned',
  details TEXT NOT NULL DEFAULT '{}',
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER
) AS PlotRow;

CREATE INDEX plots_farm ON plots (farm_id, name) WHERE deleted_at IS NULL;

CREATE TABLE crop_cycles (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  plot_id TEXT NOT NULL,
  crop_id TEXT NOT NULL,
  variety TEXT,
  plant_count INTEGER,
  area_share INTEGER,
  season TEXT,
  planted_on TEXT,
  started_on TEXT,
  ended_on TEXT,
  status TEXT NOT NULL DEFAULT 'active',
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER
) AS CropCycleRow;

CREATE INDEX crop_cycles_plot ON crop_cycles (plot_id, status) WHERE deleted_at IS NULL;
CREATE INDEX crop_cycles_farm ON crop_cycles (farm_id, status) WHERE deleted_at IS NULL;

CREATE TABLE tasks (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  crop_cycle_id TEXT,
  plot_id TEXT,
  title TEXT NOT NULL,
  due_on TEXT,
  done_at INTEGER,
  source TEXT NOT NULL DEFAULT 'manual',
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER
) AS TaskRow;

CREATE INDEX tasks_farm_day ON tasks (farm_id, due_on, id) WHERE deleted_at IS NULL;
CREATE INDEX tasks_cycle_day ON tasks (crop_cycle_id, due_on) WHERE deleted_at IS NULL;

CREATE TABLE notes (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  noted_on TEXT NOT NULL,
  body TEXT NOT NULL,
  plot_id TEXT,
  crop_cycle_id TEXT,
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER
) AS NoteRow;

CREATE INDEX notes_farm_day ON notes (farm_id, noted_on, id) WHERE deleted_at IS NULL;
CREATE INDEX notes_cycle_day ON notes (crop_cycle_id, noted_on) WHERE deleted_at IS NULL;

-- ---------- parties ----------
CREATE TABLE parties (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  kind TEXT NOT NULL,
  name TEXT NOT NULL,
  phone TEXT,
  notes TEXT,
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER
) AS PartyRow;

CREATE INDEX parties_farm ON parties (farm_id, kind, name) WHERE deleted_at IS NULL;

-- ---------- labour ----------
CREATE TABLE workers (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  name TEXT NOT NULL,
  phone TEXT,
  skill TEXT,
  wage_type TEXT NOT NULL DEFAULT 'daily',
  default_rate_paise INTEGER NOT NULL DEFAULT 0,
  is_family BOOLEAN NOT NULL DEFAULT FALSE,
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER
) AS WorkerRow;

CREATE INDEX workers_farm ON workers (farm_id, name) WHERE deleted_at IS NULL;

CREATE TABLE labour_groups (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  label TEXT NOT NULL,
  is_named BOOLEAN NOT NULL DEFAULT FALSE,
  leader_worker_id TEXT,
  usual_size INTEGER,
  default_rates TEXT NOT NULL DEFAULT '{}',
  notes TEXT,
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER
) AS LabourGroupRow;

CREATE INDEX labour_groups_farm ON labour_groups (farm_id, label) WHERE deleted_at IS NULL;

CREATE TABLE labour_group_members (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  group_id TEXT NOT NULL,
  worker_id TEXT NOT NULL,
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER
) AS LabourGroupMemberRow;

CREATE INDEX labour_group_members_group ON labour_group_members (group_id) WHERE deleted_at IS NULL;
CREATE INDEX labour_group_members_worker ON labour_group_members (worker_id) WHERE deleted_at IS NULL;

CREATE TABLE harvests (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  crop_cycle_id TEXT NOT NULL,
  plot_id TEXT NOT NULL,
  harvested_on TEXT NOT NULL,
  quantity INTEGER NOT NULL,
  unit TEXT NOT NULL DEFAULT 'kg',
  grade_code TEXT,
  per_team_quantity BOOLEAN NOT NULL DEFAULT FALSE,
  notes TEXT,
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER,
  -- schema 2 (phase 7): why the farmer harvested inside a waiting period
  waiting_override_reason TEXT
) AS HarvestRow;

CREATE INDEX harvests_farm_day ON harvests (farm_id, harvested_on, id) WHERE deleted_at IS NULL;
CREATE INDEX harvests_cycle_day ON harvests (crop_cycle_id, harvested_on) WHERE deleted_at IS NULL;

CREATE TABLE labour_entries (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  work_date TEXT NOT NULL,
  worker_id TEXT,
  group_id TEXT,
  crop_cycle_id TEXT,
  plot_id TEXT,
  harvest_id TEXT,
  task_code TEXT,
  rate_class TEXT,
  head_count INTEGER NOT NULL DEFAULT 1,
  attendance INTEGER NOT NULL DEFAULT 1000 CHECK (attendance BETWEEN 0 AND 1000),
  wage_type TEXT NOT NULL DEFAULT 'daily',
  hours INTEGER,
  overtime_hours INTEGER,
  overtime_rate_paise INTEGER,
  rate_paise INTEGER NOT NULL DEFAULT 0,
  piece_quantity INTEGER,
  piece_unit TEXT,
  amount_paise INTEGER NOT NULL DEFAULT 0,
  amount_overridden BOOLEAN NOT NULL DEFAULT FALSE,
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER,
  CHECK (worker_id IS NOT NULL OR group_id IS NOT NULL)
) AS LabourEntryRow;

CREATE INDEX labour_entries_farm_day ON labour_entries (farm_id, work_date, id) WHERE deleted_at IS NULL;
CREATE INDEX labour_entries_cycle_day ON labour_entries (crop_cycle_id, work_date) WHERE deleted_at IS NULL;
CREATE INDEX labour_entries_worker_day ON labour_entries (worker_id, work_date) WHERE deleted_at IS NULL;
CREATE INDEX labour_entries_group_day ON labour_entries (group_id, work_date) WHERE deleted_at IS NULL;
CREATE INDEX labour_entries_harvest ON labour_entries (harvest_id) WHERE deleted_at IS NULL;

CREATE TABLE labour_allocations (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  labour_entry_id TEXT NOT NULL,
  crop_cycle_id TEXT NOT NULL,
  amount_paise INTEGER NOT NULL,
  is_manual BOOLEAN NOT NULL DEFAULT FALSE,
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER
) AS LabourAllocationRow;

CREATE INDEX labour_allocations_entry ON labour_allocations (labour_entry_id) WHERE deleted_at IS NULL;
CREATE INDEX labour_allocations_cycle ON labour_allocations (crop_cycle_id) WHERE deleted_at IS NULL;

CREATE TABLE labour_payments (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  paid_on TEXT NOT NULL,
  worker_id TEXT,
  group_id TEXT,
  kind TEXT NOT NULL,
  amount_paise INTEGER NOT NULL,
  mode TEXT NOT NULL DEFAULT 'cash',
  notes TEXT,
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER,
  CHECK (worker_id IS NOT NULL OR group_id IS NOT NULL)
) AS LabourPaymentRow;

CREATE INDEX labour_payments_farm_day ON labour_payments (farm_id, paid_on, id) WHERE deleted_at IS NULL;
CREATE INDEX labour_payments_worker_day ON labour_payments (worker_id, paid_on) WHERE deleted_at IS NULL;
CREATE INDEX labour_payments_group_day ON labour_payments (group_id, paid_on) WHERE deleted_at IS NULL;

-- ---------- expenses ----------
CREATE TABLE expenses (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  spent_on TEXT NOT NULL,
  category_code TEXT NOT NULL,
