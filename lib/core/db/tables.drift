  plot_id TEXT,
  vendor_party_id TEXT,
  mode TEXT NOT NULL DEFAULT 'cash',
  due_on TEXT,
  notes TEXT,
  photo_path TEXT,
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER
) AS ExpenseRow;

CREATE INDEX expenses_farm_day ON expenses (farm_id, spent_on, id) WHERE deleted_at IS NULL;
CREATE INDEX expenses_plot_day ON expenses (plot_id, spent_on) WHERE deleted_at IS NULL;

CREATE TABLE expense_allocations (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  expense_id TEXT NOT NULL,
  crop_cycle_id TEXT NOT NULL,
  amount_paise INTEGER NOT NULL,
  is_manual BOOLEAN NOT NULL DEFAULT FALSE,
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER
) AS ExpenseAllocationRow;

CREATE INDEX expense_allocations_expense ON expense_allocations (expense_id) WHERE deleted_at IS NULL;
CREATE INDEX expense_allocations_cycle ON expense_allocations (crop_cycle_id) WHERE deleted_at IS NULL;

CREATE TABLE expense_payments (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  expense_id TEXT NOT NULL,
  paid_on TEXT NOT NULL,
  amount_paise INTEGER NOT NULL,
  mode TEXT NOT NULL DEFAULT 'cash',
  notes TEXT,
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER
) AS ExpensePaymentRow;

CREATE INDEX expense_payments_farm_day ON expense_payments (farm_id, paid_on, id) WHERE deleted_at IS NULL;
CREATE INDEX expense_payments_expense ON expense_payments (expense_id) WHERE deleted_at IS NULL;

-- ---------- lots and sales ----------
CREATE TABLE lots (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  crop_cycle_id TEXT NOT NULL,
  harvest_id TEXT,
  label TEXT,
  quantity INTEGER NOT NULL,
  unit TEXT NOT NULL DEFAULT 'kg',
  grade_code TEXT,
  teams_stamp TEXT,
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER
) AS LotRow;

CREATE INDEX lots_cycle ON lots (crop_cycle_id) WHERE deleted_at IS NULL;
CREATE INDEX lots_farm ON lots (farm_id, created_at) WHERE deleted_at IS NULL;
CREATE INDEX lots_harvest ON lots (harvest_id) WHERE deleted_at IS NULL;

CREATE TABLE lot_costs (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  cost_paise INTEGER NOT NULL DEFAULT 0,
  cost_overridden BOOLEAN NOT NULL DEFAULT FALSE,
  teams_stamp TEXT,
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER
) AS LotCostRow;

CREATE TABLE sales (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  sold_on TEXT NOT NULL,
  buyer_party_id TEXT,
  sale_type TEXT NOT NULL DEFAULT 'trader',
  quantity INTEGER NOT NULL,
  unit TEXT NOT NULL DEFAULT 'kg',
  grade_code TEXT,
  rate_paise INTEGER NOT NULL,
  deductions TEXT NOT NULL DEFAULT '[]',
  net_paise INTEGER NOT NULL,
  payment_due_on TEXT,
  mode TEXT NOT NULL DEFAULT 'cash',
  notes TEXT,
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER
) AS SaleRow;

CREATE INDEX sales_farm_day ON sales (farm_id, sold_on, id) WHERE deleted_at IS NULL;
CREATE INDEX sales_buyer_day ON sales (buyer_party_id, sold_on) WHERE deleted_at IS NULL;

CREATE TABLE sale_lots (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  sale_id TEXT NOT NULL,
  lot_id TEXT NOT NULL,
  quantity INTEGER NOT NULL,
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER
) AS SaleLotRow;

CREATE INDEX sale_lots_sale ON sale_lots (sale_id) WHERE deleted_at IS NULL;
CREATE INDEX sale_lots_lot ON sale_lots (lot_id, quantity) WHERE deleted_at IS NULL;

CREATE TABLE sale_payments (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  sale_id TEXT NOT NULL,
  received_on TEXT NOT NULL,
  amount_paise INTEGER NOT NULL,
  mode TEXT NOT NULL DEFAULT 'cash',
  notes TEXT,
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER
) AS SalePaymentRow;

CREATE INDEX sale_payments_farm_day ON sale_payments (farm_id, received_on, id) WHERE deleted_at IS NULL;
CREATE INDEX sale_payments_sale ON sale_payments (sale_id) WHERE deleted_at IS NULL;

CREATE TABLE other_income (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  received_on TEXT NOT NULL,
  source_code TEXT NOT NULL,
  amount_paise INTEGER NOT NULL,
  crop_cycle_id TEXT,
  notes TEXT,
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER
) AS OtherIncomeRow;

CREATE INDEX other_income_farm_day ON other_income (farm_id, received_on, id) WHERE deleted_at IS NULL;
CREATE INDEX other_income_cycle_day ON other_income (crop_cycle_id, received_on) WHERE deleted_at IS NULL;

-- ---------- prices ----------
CREATE TABLE market_prices (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT,
  crop_id TEXT NOT NULL,
  grade_code TEXT,
  market TEXT NOT NULL,
  price_paise INTEGER NOT NULL,
  unit TEXT NOT NULL DEFAULT 'kg',
  source TEXT NOT NULL,
  published_at INTEGER NOT NULL,
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER
) AS MarketPriceRow;

CREATE INDEX market_prices_crop ON market_prices (crop_id, market, published_at) WHERE deleted_at IS NULL;

CREATE TABLE price_alerts (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  user_id TEXT NOT NULL,
  crop_id TEXT NOT NULL,
  market TEXT,
  threshold_paise INTEGER NOT NULL,
  direction TEXT NOT NULL DEFAULT 'above',
  is_active BOOLEAN NOT NULL DEFAULT TRUE,
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER
) AS PriceAlertRow;

CREATE INDEX price_alerts_crop ON price_alerts (crop_id) WHERE deleted_at IS NULL;

-- ---------- inputs and stock (schema 2, phase 7) ----------
-- Stock on hand is the sum of stock_movements.quantity; a purchase's price is its expense's
-- amount; an application's quantity is its movement's, and it has no cost of its own.
CREATE TABLE input_items (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  template_item_id TEXT,
  name_ml TEXT,
  name_en TEXT,
  category_code TEXT NOT NULL DEFAULT 'fertiliser',
  unit TEXT NOT NULL DEFAULT 'kg',
  pack_size INTEGER,
  reorder_level INTEGER,
  waiting_days INTEGER,
  notes TEXT,
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER,
  CHECK (template_item_id IS NOT NULL OR name_ml IS NOT NULL OR name_en IS NOT NULL)
) AS InputItemRow;

CREATE INDEX input_items_farm ON input_items (farm_id) WHERE deleted_at IS NULL;

CREATE TABLE input_applications (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  applied_on TEXT NOT NULL,
  item_id TEXT NOT NULL,
  plot_id TEXT NOT NULL,
  crop_cycle_id TEXT NOT NULL,
  method_code TEXT,
  worker_id TEXT,
  group_id TEXT,
  waiting_days INTEGER,
  dose TEXT,
  notes TEXT,
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER
) AS InputApplicationRow;

CREATE INDEX input_applications_farm_day ON input_applications (farm_id, applied_on, id) WHERE deleted_at IS NULL;
CREATE INDEX input_applications_cycle_day ON input_applications (crop_cycle_id, applied_on) WHERE deleted_at IS NULL;

CREATE TABLE stock_movements (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  item_id TEXT NOT NULL,
  moved_on TEXT NOT NULL,
  kind TEXT NOT NULL,
  quantity INTEGER NOT NULL CHECK (quantity <> 0),
  expense_id TEXT,
  application_id TEXT,
  batch TEXT,
  expires_on TEXT,
  reason TEXT,
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER,
  CHECK (kind <> 'purchase' OR (quantity > 0 AND expense_id IS NOT NULL)),
  CHECK (kind <> 'application' OR (quantity < 0 AND application_id IS NOT NULL)),
  CHECK (kind <> 'adjustment' OR (expense_id IS NULL AND application_id IS NULL))
) AS StockMovementRow;

CREATE INDEX stock_movements_item_day ON stock_movements (item_id, moved_on) WHERE deleted_at IS NULL;
CREATE INDEX stock_movements_farm_day ON stock_movements (farm_id, moved_on, id) WHERE deleted_at IS NULL;
CREATE INDEX stock_movements_expense ON stock_movements (expense_id) WHERE deleted_at IS NULL;
CREATE INDEX stock_movements_application ON stock_movements (application_id) WHERE deleted_at IS NULL;

CREATE TABLE soil_tests (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  plot_id TEXT NOT NULL,
  tested_on TEXT NOT NULL,
  lab TEXT,
  results TEXT NOT NULL DEFAULT '{}',
  photo_path TEXT,
  notes TEXT,
  created_at INTEGER NOT NULL,
  created_by TEXT,
  updated_at INTEGER NOT NULL,
  updated_by TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  deleted_at INTEGER
) AS SoilTestRow;

CREATE INDEX soil_tests_plot_day ON soil_tests (plot_id, tested_on) WHERE deleted_at IS NULL;

-- ---------- history ----------
CREATE TABLE event_log (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  entity TEXT NOT NULL,
  entity_id TEXT NOT NULL,
  "action" TEXT NOT NULL,
  summary TEXT NOT NULL DEFAULT '{}',
  old_values TEXT,
  new_values TEXT,
  occurred_on TEXT NOT NULL,
  created_at INTEGER NOT NULL,
  created_by TEXT
) AS EventLogRow;

CREATE INDEX event_log_farm_day ON event_log (farm_id, occurred_on, created_at, id);
CREATE INDEX event_log_entity ON event_log (entity, entity_id, created_at);

-- ---------- phone only ----------
-- What to upload. One pending row per changed row: later edits update it (coalescing).
-- base_version is the row's version as last received from the server (0 for a new row),
-- so the server can tell "I changed version N" however many edits were folded together.
CREATE TABLE outbox (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  farm_id TEXT NOT NULL,
  entity TEXT NOT NULL,
  row_id TEXT NOT NULL,
  base_version INTEGER NOT NULL,
  status TEXT NOT NULL DEFAULT 'pending', -- pending, sending, rejected
  batch_id TEXT,               -- set when sent; a retry resends the same batch
  attempts INTEGER NOT NULL DEFAULT 0,
  last_error TEXT,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL
) AS OutboxRow;

CREATE INDEX outbox_queue ON outbox (status, created_at);
CREATE UNIQUE INDEX outbox_pending ON outbox (entity, row_id) WHERE status = 'pending';
CREATE INDEX outbox_row ON outbox (entity, row_id, status);

-- The last server_seq pulled, per farm and table ('' farm for master data).
CREATE TABLE sync_state (
  farm_id TEXT NOT NULL,
  entity TEXT NOT NULL,
  cursor INTEGER NOT NULL DEFAULT 0,
  pulled_at INTEGER,
  PRIMARY KEY (farm_id, entity)
) AS SyncStateRow;

-- Changes the server could not merge on its own; shown to the farmer to choose.
CREATE TABLE conflicts (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  entity TEXT NOT NULL,
  row_id TEXT NOT NULL,
  kind TEXT NOT NULL,          -- same_field, delete_edit, orphan, oversell
  fields TEXT NOT NULL DEFAULT '[]',
  mine TEXT,                   -- this phone's row, JSON
  theirs TEXT,                 -- the server's row, JSON
  created_at INTEGER NOT NULL,
  resolved_at INTEGER,
  resolution TEXT
) AS ConflictRow;

CREATE INDEX conflicts_open ON conflicts (farm_id, created_at) WHERE resolved_at IS NULL;

-- Photos upload from their own queue so a large photo never delays entries.
CREATE TABLE photo_uploads (
  id TEXT NOT NULL PRIMARY KEY,
  farm_id TEXT NOT NULL,
  entity TEXT NOT NULL,
  row_id TEXT NOT NULL,
  local_path TEXT NOT NULL,
  remote_path TEXT,
  status TEXT NOT NULL DEFAULT 'pending',
  attempts INTEGER NOT NULL DEFAULT 0,
  created_at INTEGER NOT NULL
) AS PhotoUploadRow;

CREATE INDEX photo_uploads_queue ON photo_uploads (status, created_at);

CREATE TABLE app_settings (
  "key" TEXT NOT NULL PRIMARY KEY,
  value TEXT NOT NULL
) AS AppSettingRow;
